import { HabitatView, Needs, Portrait, DecisionForm, ArtThumb, FieldJournal, DayHistory } from "../ui"
Page Pet variant=$pageStyle
  Row variant=topbar
    Row variant=wordmark
      Image src="./icon.svg" alt=""
      Text "Pet"
      Text variant=workspaceLabel "One Workspace"
    Row variant=nav
      Link variant=apps href=$workspace "Apps"
      If condition=$world
        Button variant=journalButton action=journal "Journal"
      If condition=$session
        Button variant=quiet action=logout "Sign out"
  Alert $notice
  If condition=$loading
    Card variant=welcome
      Heading level=1 "Opening the hollow…"
  If condition=$signedOut
    Card variant=welcome
      Heading level=1 "Clover Hollow"
      Text "Visit a little woodland world and see what your pet is up to."
      If condition=$oidc
        Link variant=primary href="./auth/login" "Continue with MyAccounts"
  If condition=$unadopted
    Card variant=welcome
      Heading level=1 "Make yourself at home"
      If condition=$owner
        Text "Name the pet who will live in Clover Hollow."
        Input label="Pet name" name=name limit=22 placeholder="Pip"
        Button variant=primary action=adopt disabled=$busy "Welcome your pet"
      Else
        Text "The Workspace owner can welcome the first pet."
  If condition=$world
    HabitatView state=$world
    Row variant=titlebar
      Heading level=1 "Clover Hollow"
      Row variant=worldclock
        Text variant=clockIcon $sun
        Stack
          Text variant=clockValue $clock
          Text variant=clockDay $day
          Text variant=location $weather
    Card variant=petCard
      Row variant=petIdentity
        Portrait mood=$world.mood
        Stack
          Heading level=2 $world.name
          Badge variant=mood $world.mood
      Text variant=activity $activity
      Text variant=decisionSource $world.source
      Needs state=$world
    Button variant=treat action=treat disabled=$treatDisabled $treatLabel
    FieldJournal open=$journalOpen onClose=$closeJournal
      If condition=$journalOpen
        DayHistory account=$account currentDay=$world.day tick=$world.tick
      Card variant=gallery
        If condition=$world.project
          Text variant=projectStatus $projectSummary
        Row variant=sectionTop
          Heading level=2 "Made in the hollow"
          Text variant=smallLabel $galleryCount
        If condition=$emptyGallery
          Text variant=muted "Paintings and sculptures will appear here as your pet makes them."
        Row variant=galleryItems
          For each=$creations
            ArtThumb item=$item
      If condition=$owner
        Card variant=brainCard
          DecisionForm state=$settings
