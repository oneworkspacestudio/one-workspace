Page Console
  Row
    Heading level=1 "Web Search"
    Spacer
    Link href=$workspace variant=apps "Apps"
  Text "Private browser research for your LLMs"
  If condition=$signedOut
    Card
      Heading level=2 "Connect your account"
      Text "Use your Workspace owner account to manage Web Search."
      Link href=$login "Continue with MyAccounts"
  Else
    Card
      Row
        Heading level=2 "Browser service"
        Badge $state
      Text "Fara 1.5 4B · Local model · Private browser profile"
      Text $queueLabel
      Text $setupLabel
      Button action=install disabled=$installDisabled "Install local model (3.4 GB)"
      Row
        Button action=enable disabled=$enableDisabled "Turn on"
        Button action=disable disabled=$disabled "Turn off"
      Alert $notice
    Grid
      Card
        Heading level=2 "Ask a question"
        Input name=query label="Research question" type=textarea placeholder="What would you like to find on the web?"
        Button action=search disabled=$notReady "Queue research"
        For each=$jobs
          Card
            Row
              Text $item.query
              Badge $item.status
            Text $item.error
            Text $item.answer
            For each=$item.sources
              Link href=$item.url "$item.title"
              Text $item.excerpt
            Button action=cancel item=$item.id "Cancel request"
      Card
        Heading level=2 "API access"
        Text "Credentials grant trusted server apps access to this browser profile. Keep them on your server."
        Input name=name label="Credential name" placeholder="My research agent"
        Button action=create "Create credential"
        If condition=$token
          Alert "Copy this credential now. It is shown once."
          Text variant=pre $token
          Button action=dismiss "I have saved it"
        Text variant=pre $apiExample
        For each=$grants
          Row
            Text $item.name
            Button action=revoke item=$item.hash "Revoke"
    Card id="remote-browser"
      Heading level=2 "Remote browser"
      Text "Resolve sign-in prompts and browser issues in the same private profile. Taking control pauses research. No local model is needed."
      Text $remoteLabel
      Row
        Button action=openRemote disabled=$remoteOpenDisabled "Open remote browser"
        Button action=reconnectRemote disabled=$remoteClosed "Reconnect"
        Button action=closeRemote disabled=$remoteClosed "Release control"
      If condition=$remoteOpen
        Text "Click or tap the screen to focus it, then type, paste, drag or scroll. Interrupted research must be submitted again. Closing this view releases the browser back to research."
        Input name=address label="Browser address" placeholder="https://example.com"
        Row
          Button action=navigate disabled=$remoteNotReady "Go"
          Button action=back disabled=$remoteNotReady "Back"
          Button action=forward disabled=$remoteNotReady "Forward"
          Button action=reload disabled=$remoteNotReady "Reload"
          Button action=newTab disabled=$remoteNotReady "New tab"
          Button action=closeTab disabled=$remoteNotReady "Close tab"
          Button action=fullscreen disabled=$remoteNotReady "Full screen"
        For each=$tabs
          Button action=selectTab item=$item.id disabled=$item.active "$item.label"
        Text $remotePage
        If condition=$remoteImage
          Image variant=remote src=$remoteImage alt="Remote browser screen"
        Input name=remoteText label="Private text to type" type=password placeholder="Type or paste text, then choose Send text"
        Row
          Button action=sendText disabled=$remoteNotReady "Send text"
          Button action=enter disabled=$remoteNotReady "Enter"
          Button action=tab disabled=$remoteNotReady "Tab"
          Button action=scrollUp disabled=$remoteNotReady "Scroll up"
          Button action=scrollDown disabled=$remoteNotReady "Scroll down"
        Text "This view controls the research browser, not your PC desktop. Clipboard and operating-system shortcuts stay blocked. Release control when finished; disconnected sessions expire after 90 seconds."
    Text "Requests and results expire after 24 hours. Sign-in challenges pause research."
